# Postgres via Neon (integração nativa do Vercel: Storage → Create Database
# → Postgres). Os dois nomes abaixo são exatamente os que o Vercel injeta
# sozinho no projeto quando você cria o banco por lá — não precisa
# configurar nada extra no dashboard.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Senha do /admin (Basic Auth). Sem essa variável, o padrão no código é
# "2001" — troque aqui antes de qualquer deploy público, sem mexer em nada
# mais.
ADMIN_PASSWORD="2001"

# WhatsApp comercial pra onde a consulta leva o cliente (só dígitos, com DDI
# 55 + DDD + número, ex.: 5585912345678). É NEXT_PUBLIC_: o Next embute o valor
# no build, então trocar exige novo deploy. Sem isso, o botão vira "me chamem"
# e a conversa parte do número que o cliente informou na consulta.
NEXT_PUBLIC_WHATSAPP_NUMBER="5585912345678"

# Pagamento (AbacatePay). Chave de teste "abc_dev_..."; em produção a chave real, só no Vercel,
# como variável sensível. Permissões: CHECKOUT:CREATE, CHECKOUT:READ, REFUND:CREATE,
# CUSTOMER:CREATE e PRODUCT:READ. Sem a chave o pagamento pelo site fica desligado.
ABACATEPAY_API_KEY=""
# Mesmo valor do "webhookSecret" da URL do webhook cadastrada no painel do AbacatePay.
ABACATEPAY_WEBHOOK_SECRET=""
# Endereço do site, para o AbacatePay devolver o cliente depois de pagar (padrão: https://www.marcasync.com.br).
SITE_URL=""
