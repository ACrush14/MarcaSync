# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# banco de dados local (SQLite) — cada máquina/ambiente gera o seu via
# `npx prisma migrate dev`. Nunca comitar dado real de cliente.
/prisma/*.db
/prisma/*.db-journal

# client do Prisma gerado por `npx prisma generate` (roda automaticamente
# dentro de `migrate dev`) — sempre recriável a partir de prisma/schema.prisma,
# nunca precisa ir pro histórico do git.
/src/generated/

# typescript
*.tsbuildinfo
next-env.d.ts
