// Postgres (Neon, via integração nativa do Vercel) — "caderno de anotações"
// real do MarcaSync.
//
// Era SQLite local até 26/08/2026; migrado pra Postgres pro deploy no
// Vercel, porque o Vercel não tem disco persistente (sistema de arquivos é
// só leitura fora de /tmp) — um arquivo .db local não sobreviveria a um
// único redeploy. DATABASE_URL (conexão via pooler, pro app em runtime) e
// DIRECT_URL (conexão direta, só pro Prisma CLI rodar migration) vêm do
// Neon através da integração do Vercel — ver seção "Banco de dados" do
// README pra como configurar isso localmente.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

/// Quem contratou o serviço — capturado no primeiro passo do wizard (Consulta).
model Cliente {
  id        String     @id @default(cuid())
  nome      String
  whatsapp  String     @unique
  email     String?
  createdAt DateTime   @default(now())
  processos Processo[]
}

/// Um pedido de registro de marca em andamento (uma "linha" no caderno).
model Processo {
  id                   String             @id @default(cuid())
  clienteId            String
  cliente              Cliente            @relation(fields: [clienteId], references: [id])
  situacaoInpi         String?
  situacaoVerificadaEm DateTime?
  situacoes            SituacaoProcesso[]

  // Frequência do monitoramento (ver src/lib/cadencia.ts): semanal até você marcar "protocolo OK"
  // no /admin; depois, mensal. Uma mudança do INPI volta o processo para semanal sozinha.
  monitoramentoMensalDesde DateTime?
  rpiVerificadaEm          DateTime? // última leitura da RPI feita por causa deste processo

  marca     String
  descricao String

  // Resultado da análise (snapshot do momento — não recalcula depois).
  nclCode    String?
  nclLabel   String?
  riscoPct   Int?
  riscoFonte String? // "real" (busca real no INPI) | "demo" (busca real falhou, ver colidencia.ts)

  monitoramento  Boolean   @default(false)
  protocolo      String? // número interno gerado no passo "Plano"
  gruPagaInpiEm  DateTime? // quando a GRU foi paga ao INPI (a partir daí a taxa não volta)
  protocoladoEm  DateTime? // quando o pedido foi protocolado no e-Marcas (a partir daí o serviço está concluído)
  numeroProcesso String? // número real do INPI, preenchido só quando protocolado de verdade
  logoUrl        String? // logotipo da marca (PNG, até 1000x1000), Vercel Blob — só marca mista

  // consulta -> resultado -> plano -> protocolado
  status String @default("consulta")

  // Acompanhamento do contato (só você vê, no /admin): quem tem interesse e quando falar de novo.
  interesse        String    @default("novo") // novo | interessado | acompanhar | sem_interesse
  proximoContatoEm DateTime? // dia combinado para falar de novo (guardado ao meio-dia UTC)
  ultimoContatoEm  DateTime? // quando você marcou "falei com a pessoa"
  anotacoes        String? // suas anotações sobre a conversa

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pagamentos      Pagamento[]
  alertas         Alerta[]
  pedidoRegistro  PedidoRegistro?
  imagemMarca     ImagemMarca?
  prazos          Prazo[]
  reciboProtocolo ReciboProtocolo?
  conferenciasGru ConferenciaGru[]
  geracoesLogo    GeracaoLogo[]
}

/// Uma cobrança (setup ou mensalidade de monitoramento) — confirmada à mão
/// por enquanto, depois que o cliente avisa por WhatsApp que pagou.
model Pagamento {
  id         String   @id @default(cuid())
  processoId String
  processo   Processo @relation(fields: [processoId], references: [id])

  tipo          String // "pacote" (serviço + taxa do INPI, um pagamento só) | "monitoramento"; "setup" e "gru" são do modelo antigo, de dois Pix
  valorCentavos Int

  status        String    @default("pendente") // pendente | confirmado | estornado | expirado
  confirmadoEm  DateTime?
  confirmadoVia String? // ex.: "abacatepay" ou "whatsapp" (reserva)
  notas         String?

  // Cobrança no AbacatePay (nula quando o pagamento foi combinado fora do site)
  provedorId  String?   @unique // id da cobrança: checkout (bill_...) ou, no modelo antigo, Pix (pix_char_...)
  brCode      String? // Pix copia e cola (só no modelo antigo)
  checkoutUrl String? // página de pagamento do AbacatePay (Pix ou cartão)
  expiraEm    DateTime?
  estornadoEm DateTime?
  estornoId   String?
  // Devolução parcial feita à mão (o AbacatePay não estorna parte do valor): quanto já voltou.
  devolvidoCentavos Int @default(0)

  createdAt DateTime @default(now())
}

/// Um despacho da RPI que apareceu para um processo monitorado. A chave
/// única evita duplicar o aviso se a rotina rodar duas vezes na mesma edição.
model Alerta {
  id         String   @id @default(cuid())
  processoId String
  processo   Processo @relation(fields: [processoId], references: [id])

  edicao         Int?
  dataEdicao     DateTime?
  despachoCodigo String?
  despachoNome   String?
  tipo           String // "oposicao" | "despacho"
  prazoAte       DateTime? // só em oposição: 60 dias da publicação (estimativa, conferir na RPI)
  origem         String    @default("rpi")
  situacaoNova   String?
  avisadoEm      DateTime? // marcado à mão no /admin depois de avisar o cliente
  createdAt      DateTime  @default(now())

  @@unique([processoId, edicao, despachoCodigo])
  @@index([avisadoEm])
}

/// Edições da RPI que a rotina de monitoramento já leu por completo.
model LeituraRpi {
  edicao      Int      @id
  lidaEm      DateTime @default(now())
  verificados Int
  encontrados Int
}

/// Cópia local (só marcas vivas, com elemento nominativo) da base oficial de
/// dados abertos do INPI — ver scripts/ingerir-marcas.mjs. Serve para achar
/// marcas de som parecido que a busca textual do INPI não traz no top 10.
model MarcaInpi {
  numero   String    @id
  nome     String
  chave    String // foneticaBR(nome), indexada pra busca por som
  situacao String // código IPAS (descrição em src/lib/situacoes-inpi.ts)
  deposito DateTime? @db.Date
  classes  String? // classes de Nice, ex.: "25,35"
  lote     Int // execução da ingestão que gravou/confirmou a linha

  @@index([chave(ops: raw("text_pattern_ops"))])
}

/// Uma linha por ingestão concluída — diz de quando é a base local.
model IngestaoMarcas {
  lote            Int      @id
  concluidaEm     DateTime @default(now())
  total           Int
  fonteAtualizada String? // Last-Modified do arquivo do INPI
}

model Evento {
  id        String   @id @default(cuid())
  sessaoId  String
  nome      String
  pagina    String?
  origem    String?
  dados     Json?
  createdAt DateTime @default(now())

  @@index([nome, createdAt])
  @@index([sessaoId])
}

model SituacaoProcesso {
  id         String   @id @default(cuid())
  processoId String
  processo   Processo @relation(fields: [processoId], references: [id])
  situacao   String
  origem     String // "consulta" | "rpi"
  vistaEm    DateTime @default(now())

  @@index([processoId, vistaEm])
}

///limita a quantidade de tentativas para o admin.
///ele pega numero de vezes tentadas x IP. O horário é para dar um cooldown
///de 15 minutos após o IP ser barrado.

model TentativaAdmin {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

/// Dados que o cliente informa, depois de ver o resultado e o plano, para o pedido de
/// registro ser protocolado no e-Marcas (Manual de Marcas do INPI, itens 3.1 e 3.5.2).
/// Um por processo. NÃO guarda login nem senha do e-INPI ou do gov.br: quem entra no
/// sistema do INPI para emitir a GRU e protocolar é o procurador, com o login dele.
/// Os valores em centavos são calculados no servidor, nunca aceitos do navegador.
model PedidoRegistro {
  id         String   @id @default(cuid())
  processoId String   @unique
  processo   Processo @relation(fields: [processoId], references: [id])

  // Requerente
  tipoRequerente         String // "pf" | "pj"
  regime                 String // pessoa_natural | mei | microempresa | empresa_pequeno_porte | sem_fins_lucrativos | outra_empresa
  participaEmpresaDoRamo Boolean @default(false) // só pessoa natural: se tem sociedade em empresa do ramo
  nome                   String // nome completo ou razão social, sem abreviações
  documento              String // CPF ou CNPJ, só dígitos
  email                  String
  cep                    String
  logradouro             String
  numero                 String
  complemento            String?
  bairro                 String
  cidade                 String
  uf                     String

  // Marca e pedido
  apresentacao        String // nominativa | figurativa | mista
  elementoNominativo  String? // o texto da marca (nominativa e mista)
  classeNice          String // uma classe por pedido (o e-Marcas não tem multiclasse)
  especificacao       String // produtos ou serviços que a marca vai assinalar
  atividade           String // declaração de atividade (art. 128 da Lei 9.279/96)
  especificacaoItens  String[] // um item por posição (os da lista do INPI e os digitados)
  especificacaoLivre  Boolean  @default(false) // true se algum item não está na lista pré-aprovada (GRU 394)
  palavraEstrangeira  Boolean  @default(false) // o nome tem palavra em outro idioma
  traducao            String? // tradução da palavra estrangeira, exigida pelo e-Marcas
  cienteAnterioridade Boolean  @default(false) // o cliente viu o aviso de marca anterior parecida no ramo

  // Valores calculados no servidor
  servicoCentavos Int
  gruCentavos     Int
  gruComDesconto  Boolean

  aceitoEm  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A imagem da marca (figurativa ou mista), guardada no banco para o protocolo no e-Marcas.
/// `jpg` já está no formato que o INPI pede; `original` é o arquivo como o cliente enviou.
model ImagemMarca {
  id         String   @id @default(cuid())
  processoId String   @unique
  processo   Processo @relation(fields: [processoId], references: [id])

  jpg             Bytes // JPG, RGB, 300 dpi, lado menor de pelo menos 945 px, até 2 MB
  original        Bytes
  mimeOriginal    String
  larguraOriginal Int
  alturaOriginal  Int
  largura         Int
  altura          Int
  ampliada        Boolean @default(false) // true se o original era menor que 945 px e foi ampliado

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Uma logo criada pela IA (Gemini) para o pedido. Só guardamos que foi gerada, para limitar quantas
/// o pedido pode gerar e quantas o site gera por dia (cada uma custa centavos); a imagem em si não é
/// guardada: o cliente escolhe uma e ela entra pelo envio normal da imagem da marca.
model GeracaoLogo {
  id         String   @id @default(cuid())
  processoId String
  processo   Processo @relation(fields: [processoId], references: [id])
  estilo     String
  createdAt  DateTime @default(now())

  @@index([processoId])
  @@index([createdAt])
}

/// Um prazo que corre contra o pedido (ex.: a procuração, até 60 dias do protocolo). A rotina diária
/// avisa quando faltam 30, 7 e 2 dias e quando vence; `ultimoAvisoDias` guarda o último nível avisado
/// para o mesmo aviso não sair duas vezes.
model Prazo {
  id         String   @id @default(cuid())
  processoId String
  processo   Processo @relation(fields: [processoId], references: [id])

  tipo            String // "procuracao" | "exigencia_formal" | "manifestacao" | "outro"
  descricao       String
  venceEm         DateTime
  concluidoEm     DateTime?
  ultimoAvisoDias Int? // 30, 7, 2 ou 0 (vencido); null = nenhum aviso ainda

  createdAt DateTime @default(now())

  @@index([venceEm])
}

/// Cada aviso gerado pelo sistema (para você ou para o cliente), enviado ou só guardado no painel.
model Notificacao {
  id         String  @id @default(cuid())
  processoId String?

  destino   String // "operador" | "cliente"
  canal     String // "email" | "telegram" | "painel"
  assunto   String
  texto     String
  enviadaEm DateTime?
  erro      String?

  createdAt DateTime @default(now())

  @@index([processoId])
}

/// O recibo em PDF que o e-Marcas devolve ao protocolar (traz o número do pedido e a data e hora do envio).
model ReciboProtocolo {
  id         String   @id @default(cuid())
  processoId String   @unique
  processo   Processo @relation(fields: [processoId], references: [id])

  pdf         Bytes
  nomeArquivo String
  tamanho     Int

  createdAt DateTime @default(now())
}

/// O que o robô do e-INPI viu ao conferir a GRU de um pedido (só leitura: ele não gera boleto).
model ConferenciaGru {
  id         String   @id @default(cuid())
  processoId String
  processo   Processo @relation(fields: [processoId], references: [id])

  servico          String // "389" | "394"
  esperadoCentavos Int // o que o site cobrou do cliente pela GRU
  lidoCentavos     Int? // o que o e-INPI mostrou na prévia
  resultado        String // ok | divergente | erro
  detalhe          String?

  createdAt DateTime @default(now())

  @@index([processoId, createdAt])
}

/// O último sinal de vida do robô (uma linha só, com id "principal").
model RoboEstado {
  id      String   @id
  vistoEm DateTime
  sessao  String // ok | expirada | erro (a sessão do e-INPI no Chrome do robô)
  detalhe String?
}
